# ── Required (app will not boot without these) ────────────
# Validated by lib/config.ts on first access (ADR-0001).
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/veracity
AUTH_SECRET=change-me-to-a-long-random-string
GEMINI_API_KEY=your_gemini_api_key
# Optional second key — used if primary hits 401/403/429 (auth or quota)
# GEMINI_API_KEY_FALLBACK=your_second_gemini_api_key

# ── AI overrides (optional) ───────────────────────────────
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
# Free-tier tip: gemini-3.1-flash-lite works for most new free keys.
# gemini-2.5-flash is often 404/429 for new accounts. App also auto-falls back.# GEMINI_EMBEDDING_DIMENSIONS=768
# GEMINI_THINKING_BUDGET=0

# ── Tool APIs (optional — agents degrade when absent) ─────
FIRECRAWL_API_KEY=fc-your_firecrawl_key
SERPAPI_KEY=your_serpapi_key
# Apify: used by market-trends + competitive agents (Tweet Scraper).
APIFY_API_TOKEN=your_apify_api_token
# APIFY_MAX_WAIT_SECS=40
# APIFY_DEBUG=1
# APIFY_TWITTER_ACTOR_ID=61RPP7dywgiy0JPD0

# ── Scrape.do (optional anti-bot fallback) ────────────────
SCRAPE_DO_TOKEN=

# ── Reddit (optional) ─────────────────────────────────────
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=

# ── Meta Ads (optional) ───────────────────────────────────
META_ADS_TOKEN=

# ── MiroFish (local Gemini swarm in mirofish-service/) ────
# Recommended: run beside Next.js (no separate VPS required).
#   npm run mirofish
#   npm run mirofish:bootstrap
# Paste the printed simulation map below, then restart Next.js.
# The MiroFish service is a private worker, not a public API. It holds a model
# key and does unbounded model work per request, so it requires a shared secret
# on every route and binds loopback by default.
#
# MIROFISH_SERVICE_TOKEN must match on both sides. Without it the service
# returns 503 for every API route rather than falling open.
MIROFISH_SERVICE_TOKEN=
# Origin allowed to call it. Restricted rather than "*".
MIROFISH_ALLOWED_ORIGIN=http://localhost:3000
# Listen address. Leave as loopback unless the service genuinely must be
# reachable from another host, in which case front it with a real WSGI server.
MIROFISH_HOST=127.0.0.1

MIROFISH_BASE_URL=http://localhost:5001
MIROFISH_SIMULATIONS={}

# ── MiroFish Live (same local service, or remote URL) ─────
MIROFISH_LIVE_BASE_URL=http://localhost:5001
MIROFISH_LIVE_SIMULATIONS={}
# MIROFISH_LIVE_DEFAULT_SIMULATION_ID=
# MIROFISH_LIVE_MAX_AGENTS=5
# MIROFISH_LIVE_INTERVIEW_TIMEOUT_SEC=240
# MIROFISH_LIVE_STRICT_SERIAL_MODE=0

# ── Google OAuth (optional) ───────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Rate limiting (Upstash Redis) ─────────────────────────
# Optional locally (fail-open). Recommended in production.
# Console: https://console.upstash.com → Redis → REST API
UPSTASH_REDIS_REST_URL=https://xxxx.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_token

# ── Observability (optional) ───────────────────────────────
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# ── Phase 3B feature flags (default ON when unset; set 0/false/off to disable)
NEXT_PUBLIC_FF_EVIDENCE_TRAIL=1
NEXT_PUBLIC_FF_ORCHESTRATOR_VIEW=1
NEXT_PUBLIC_FF_BOARD_MODE=1
# Phase 6 — async defaults on but safely uses sync unless Inngest is explicitly ready
NEXT_PUBLIC_FF_ASYNC_SWEEP=1
# Phase 5 Continuous Platform (watchlists/alerts/timeline default ON)
NEXT_PUBLIC_FF_AUDIT_LOGS=0
NEXT_PUBLIC_FF_WATCHLISTS=0
NEXT_PUBLIC_FF_ALERTS=0
NEXT_PUBLIC_FF_DECISION_MEMORY=0
NEXT_PUBLIC_FF_COMPETITIVE_TIMELINE=0
NEXT_PUBLIC_FF_FEEDBACK_LEARNING=0
# Optional Phase 5 alert egress. In-app alerts always work without these.
SLACK_ALERT_WEBHOOK_URL=
RESEND_API_KEY=
ALERT_FROM_EMAIL=alerts@example.com
# Phase 6 Enterprise (default OFF)
NEXT_PUBLIC_FF_CONTINUOUS_INTELLIGENCE=1
NEXT_PUBLIC_FF_WORKSPACES=0
NEXT_PUBLIC_FF_RBAC=0
NEXT_PUBLIC_FF_SAML_SSO=0
NEXT_PUBLIC_FF_ORG_INTELLIGENCE=0
# Phase 7 Knowledge Platform (default OFF)
NEXT_PUBLIC_FF_EVIDENCE_GRAPH=0
NEXT_PUBLIC_FF_COMPETITOR_PROFILES=0
NEXT_PUBLIC_FF_KG_EXPLORER=0
NEXT_PUBLIC_FF_CROSS_AGENT_MEMORY=0
NEXT_PUBLIC_FF_KG_MAINTENANCE=0
NEXT_PUBLIC_FF_KG_ANALYTICS=0
# Architecture — LangGraph wave executor (default OFF; ADR-0004 / ADR-0007)
NEXT_PUBLIC_FF_LANGGRAPH_EXECUTOR=0
# Demo SAML IdP (no real IdP required when 1)
SAML_DEMO_MODE=0

# ── Inngest (optional — required when NEXT_PUBLIC_FF_ASYNC_SWEEP=1) ─
# Dev: run `npx inngest-cli@latest dev` and set INNGEST_DEV=1.
INNGEST_DEV=0
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=
