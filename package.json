{
  "name": "ai-studio-applet",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:local": "npm run db:local:start && npm run dev",
    "db:setup": "psql -U postgres -h localhost -c \"CREATE DATABASE veracity;\" || true && psql -U postgres -h localhost -d veracity -f db/schema.sql",
    "db:schema:apply": "node scripts/apply-local-schema.mjs",
    "db:local:start": "node scripts/local-postgres.mjs start",
    "db:local:stop": "node scripts/local-postgres.mjs stop",
    "db:local:status": "node scripts/local-postgres.mjs status",
    "mirofish": "cd mirofish-service && .venv/bin/python server.py",
    "mirofish:bootstrap": "npx tsx scripts/mirofish-bootstrap-local.ts \"Vector Agents\" scripts/seeds/vector-agents.txt",
    "dev:full": "concurrently \"npm run dev\" \"npm run mirofish\"",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "clean": "next clean",
    "test": "vitest run",
    "test:quality": "npx tsx scripts/validate-output-quality.ts",
    "test:router": "npx tsx scripts/test-intent-router.ts",
    "test:api-smoke": "node scripts/api-smoke.mjs",
    "test:e2e:market-project": "node scripts/smoke-market-project.mjs",
    "test:e2e:live-research": "VERACITY_LIVE_RESEARCH=1 node scripts/smoke-market-project.mjs",
    "test:monitoring-integration": "npx tsx scripts/validate-phase5-monitoring.ts",
    "test:continuous-integration": "npx tsx scripts/validate-phase5-monitoring.ts",
    "test:phase6": "vitest run __tests__/phase6-continuous-intelligence.test.ts",
    "test:regression": "npm run typecheck && npm test && npm run test:quality",
    "quality:weekly": "LIVE_QUALITY=1 npx tsx scripts/run-weekly-live-quality.ts",
    "db:migrate:alerts": "psql \"$DATABASE_URL\" -f db/migrations/0003_alerts_timeline_decision.sql",
    "db:migrate:watchlists": "psql \"$DATABASE_URL\" -f db/migrations/0004_watchlist_continuous_mvp.sql",
    "db:migrate:continuous": "psql \"$DATABASE_URL\" -f db/migrations/0005_continuous_intelligence.sql",
    "db:migrate:market-projects": "node scripts/apply-market-projects-migration.mjs",
    "db:migrate:project-history": "node scripts/apply-project-history-migration.mjs",
    "db:migrate:project-decisions": "node scripts/apply-project-decisions-migration.mjs",
    "typecheck": "tsc --noEmit",
    "bench:recall": "npx tsx scripts/benchmark-recall.mjs",
    "bench:executors": "vitest run __tests__/bench-executor-parity.test.ts",
    "bench:executors:live": "BENCH_LIVE=1 vitest run __tests__/bench-live-sample.test.ts",
    "build:analyze": "ANALYZE=true next build",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": [
      "eslint --no-warn-ignored"
    ]
  },
  "dependencies": {
    "@google/genai": "^1.17.0",
    "@hookform/resolvers": "^5.2.1",
    "@langchain/core": "^1.2.3",
    "@langchain/langgraph": "^1.4.8",
    "@next/bundle-analyzer": "^16.2.11",
    "@opentelemetry/api": "^1.9.1",
    "@react-pdf/renderer": "^4.5.1",
    "@sentry/nextjs": "^10.67.0",
    "@splinetool/react-spline": "^4.1.0",
    "@splinetool/runtime": "^1.12.98",
    "@supabase/ssr": "^0.9.0",
    "@supabase/supabase-js": "^2.99.1",
    "@tanstack/react-query": "^5.101.4",
    "@upstash/ratelimit": "^2.0.8",
    "@upstash/redis": "^1.38.0",
    "agent-browser": "^0.24.0",
    "apify-client": "^2.23.0",
    "autoprefixer": "^10.4.21",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "docx": "^9.7.1",
    "inngest": "^4.13.0",
    "jose": "^6.2.3",
    "lucide-react": "^0.553.0",
    "motion": "^12.23.24",
    "next": "^15.4.9",
    "pg": "^8.22.0",
    "postcss": "^8.5.6",
    "posthog-js": "^1.407.1",
    "proxy-agent": "^8.0.2",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "react-error-boundary": "^6.1.2",
    "recharts": "^3.8.0",
    "tailwind-merge": "^3.3.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.1.11",
    "@tailwindcss/typography": "^0.5.19",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/pg": "^8.20.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "concurrently": "^9.2.1",
    "eslint": "9.39.1",
    "eslint-config-next": "16.0.8",
    "firebase-tools": "^15.0.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "tailwindcss": "4.1.11",
    "tw-animate-css": "^1.4.0",
    "typescript": "5.9.3",
    "vitest": "^4.1.4"
  }
}
